<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>
    <%= seoTitle %>
</title>
<meta name="description" content="<%= seoDesc %>">
<meta name="keywords" content="<%= seoKeywords %>">
<%- include('seo-meta') %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Open+Sans:wght@400;600&display=swap"
    rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>
    /* User Auth Header Styles */
    .user-auth-group {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .user-auth-group .btn-ghost {
        border: 1px solid #ddd;
        padding: 8px 15px;
        border-radius: 5px;
        text-decoration: none;
        color: #333;
        font-size: 14px;
        transition: all 0.3s ease;
    }

    .user-auth-group .btn-ghost:hover {
        background: #f4f4f4;
    }

    /* AI Chatbot Widget Styles - Forced Visibility Update */
    .chat-widget {
        position: fixed !important;
        bottom: 30px !important;
        right: 30px !important;
        z-index: 100000 !important;
        /* Increased to ensure it stays above all site sections */
        font-family: 'Open Sans', sans-serif;
        display: block !important;
    }

    #chat-button {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: #4cb050 !important;
        color: white !important;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        font-size: 28px;
        cursor: pointer;
        transition: transform 0.3s ease;
        display: flex !important;
        align-items: center;
        justify-content: center;
    }

    #chat-button:hover {
        transform: scale(1.1);
    }

    #chat-window {
        display: none;
        /* Flex applied via JS toggle */
        width: 380px;
        max-width: calc(100vw - 40px);
        height: min(560px, calc(100vh - 120px));
        background: white;
        position: absolute;
        bottom: 85px;
        right: 0;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        flex-direction: column;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.1);
    }

    .chat-header {
        background: #4cb050;
        color: white;
        padding: 20px;
        font-weight: 700;
        font-family: 'Montserrat', sans-serif;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }

    .chat-body {
        flex: 1 1 auto;
        min-height: 0;
        padding: 15px;
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: #f8f9fa;
        scroll-behavior: smooth;
    }

    .chat-footer {
        padding: 15px;
        background: white;
        border-top: 1px solid #eee;
        flex-shrink: 0;
    }

    .chat-footer input {
        width: 100% !important;
        border: 1px solid #ddd !important;
        border-radius: 25px !important;
        padding: 10px 15px !important;
        outline: none;
        font-size: 14px;
        box-sizing: border-box;
        /* Prevents input from overflowing */
    }

    .msg {
        padding: 10px 15px;
        border-radius: 18px;
        font-size: 14px;
        line-height: 1.4;
        max-width: 85%;
    }

    .bot-msg {
        background: #e9ecef;
        color: #333;
        align-self: flex-start;
        border-bottom-left-radius: 2px;
    }

    .user-msg {
        background: #c9a86c;
        color: #1e1f21;
        align-self: flex-end;
        border-bottom-right-radius: 2px;
        font-weight: 500;
    }

  .bot-msg-products {
    background: #fff !important;
    padding: 0 !important;
    max-width: 100% !important;
    width: 100%;
    align-self: stretch;
    border: 1px solid #e8eaed;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    overflow: visible;
    flex-shrink: 0;
  }

  .chat-products-intro {
    margin: 0;
    padding: 12px 14px 10px;
    font-size: 13px;
    color: #444;
    border-bottom: 1px solid #f0f0f0;
  }

  .chat-products-more-hint {
    margin: 0;
    padding: 10px 14px 12px;
    font-size: 12px;
    color: #666;
    text-align: center;
    border-top: 1px solid #f0f0f0;
    background: #fafbfc;
  }

  .chat-products-more-hint strong {
    color: #333;
  }

  .chat-product-list {
    display: flex;
    flex-direction: column;
  }

  .chat-product-row {
    display: grid;
    grid-template-columns: 36px 1fr auto auto;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-bottom: 1px solid #f0f0f0;
    text-decoration: none;
    color: inherit;
  }

  .chat-product-row:last-child {
    border-bottom: none;
  }

  .chat-product-row:hover {
    background: #fafbfc;
  }

  .chat-product-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #f0f7f1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4cb050;
    font-size: 14px;
  }

  .chat-product-info {
    min-width: 0;
  }

  .chat-product-name {
    font-weight: 600;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chat-product-cat {
    font-size: 10px;
    color: #888;
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  .chat-product-price {
    font-size: 12px;
    font-weight: 600;
    color: #333;
    white-space: nowrap;
  }

  .chat-add-btn {
    background: #c9a86c;
    color: #1e1f21;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: 0.03em;
  }

  .chat-add-btn:hover {
    background: #b89558;
  }

  .chat-footer-row {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .chat-footer-row input {
    flex: 1;
  }

  #chat-send-btn {
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 10px;
    background: #c9a86c;
    color: #1e1f21;
    cursor: pointer;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #chat-send-btn:hover {
    background: #b89558;
  }

  .chat-quick-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .chat-quick-chip {
    border: 1px solid #ddd;
    background: #fff;
    border-radius: 14px;
    padding: 5px 10px;
    font-size: 11px;
    cursor: pointer;
    color: #333;
  }

  .chat-quick-chip:hover {
    background: #f5f0e8;
    border-color: #c9a86c;
  }

  .chat-suggest-box {
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    background: #fff;
    border: 1px solid #e8eaed;
    border-radius: 10px;
    margin-bottom: 6px;
    max-height: 180px;
    overflow-y: auto;
    box-shadow: 0 -4px 16px rgba(0,0,0,0.08);
    z-index: 10;
  }

  .chat-suggest-item {
    display: block;
    width: 100%;
    text-align: left;
    border: none;
    background: none;
    padding: 10px 12px;
    border-bottom: 1px solid #f0f0f0;
    cursor: pointer;
  }

  .chat-suggest-item:hover { background: #fafbfc; }
  .chat-suggest-item span { display: block; font-weight: 600; font-size: 13px; }
  .chat-suggest-item small { color: #888; font-size: 11px; }

  .bot-msg-rich {
    background: #fff !important;
    border: 1px solid #e8eaed;
    max-width: 100% !important;
    width: 100%;
    align-self: stretch;
    flex-shrink: 0;
  }

  .timeline { margin-top: 10px; }
  .timeline-step {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 6px 0;
    font-size: 13px;
  }
  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ccc;
    margin-top: 4px;
    flex-shrink: 0;
  }
  .timeline-step.done .timeline-dot { background: #4cb050; }
  .timeline-step.current .timeline-dot { background: #c9a86c; box-shadow: 0 0 0 3px rgba(201,168,108,0.3); }
  .order-block {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid #eee;
  }
  .chat-cart-list { margin: 8px 0; padding-left: 18px; font-size: 13px; }
  .chat-checkout-link {
    display: inline-block;
    margin-top: 8px;
    color: #4cb050;
    font-weight: 700;
    font-size: 13px;
  }
  .chat-toast {
    align-self: center;
    background: #2c2c2c;
    color: #fff;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12px;
    margin: 4px 0;
  }
</style>