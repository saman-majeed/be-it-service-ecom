<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
        <title>Manage Orders</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/admin">Admin Dashboard</a>
            <a href="/" class="btn btn-outline-light btn-sm">View Website</a>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Order Lifecycle Manager</h2>
            <a href="/admin" class="btn btn-secondary">Back to Products</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Products Ordered</th>
                            <th>Total</th>
                            <th>Current Status</th>
                            <th>Action (Next Step)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders.length> 0) { %>
                            <% orders.forEach(order=> { %>
                                <tr>
                                    <td><small class="text-muted">
                                            <%= order._id %>
                                        </small></td>
                                    <td>
                                        <div><strong>
                                                <%= order.email %>
                                            </strong></div>
                                        <small>
                                            <%= order.contact %>
                                        </small>
                                    </td>
                                    <td style="min-width:220px;max-width:320px;">
                                        <% const items = Array.isArray(order.items) ? order.items : []; %>
                                        <% if (items.length > 0) { %>
                                            <ul class="list-unstyled mb-0" style="font-size:13px;">
                                                <% items.forEach(function(item) { %>
                                                    <li class="mb-1 d-flex justify-content-between gap-2">
                                                        <span>
                                                            <i class="<%= item.iconClass || 'fa-solid fa-tag' %>" style="color:#4cb050;margin-right:4px;"></i>
                                                            <%= item.name || 'Unknown item' %>
                                                            <% if (item.category) { %>
                                                                <small class="text-muted">(<%= item.category %>)</small>
                                                            <% } %>
                                                        </span>
                                                        <strong class="text-nowrap">$<%= Number(item.price || 0).toFixed(2) %></strong>
                                                    </li>
                                                <% }); %>
                                            </ul>
                                        <% } else { %>
                                            <span class="text-muted">No items recorded</span>
                                        <% } %>
                                    </td>
                                    <td>$<%= Number(order.total).toFixed(2) %>
                                    </td>
                                    <td>
                                        <% if (order.status==='Placed' ) { %>
                                            <span class="badge bg-secondary">Placed</span>
                                            <% } else if (order.status==='Processing' ) { %>
                                                <span class="badge bg-warning text-dark">Processing</span>
                                                <% } else { %>
                                                    <span class="badge bg-success">Delivered</span>
                                                    <% } %>
                                    </td>
                                    <td>
                                        <% if (order.status==='Placed' ) { %>
                                            <form action="/admin/order/update-status/<%= order._id %>" method="POST">
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    Move to Processing <i class="fa-solid fa-arrow-right"></i>
                                                </button>
                                            </form>
                                            <% } else if (order.status==='Processing' ) { %>
                                                <form action="/admin/order/update-status/<%= order._id %>"
                                                    method="POST">
                                                    <button type="submit" class="btn btn-sm btn-info text-white">
                                                        Move to Delivered <i class="fa-solid fa-truck"></i>
                                                    </button>
                                                </form>
                                                <% } else { %>
                                                    <span class="text-success"><i class="fa-solid fa-check-double"></i>
                                                        Completed</span>
                                                    <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-4">No orders found.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>

</html>